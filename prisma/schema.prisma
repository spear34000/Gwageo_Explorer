generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ExamType {
  mun
  mu
  saengwon
  jinsa
}

model Person {
  id        String            @id
  name      String
  surname   String
  bonGwan   String
  clanId    String
  residence String
  birthYear Int?
  deathYear Int?
  exams     Exam[]
  relations PersonRelation[]  @relation("from")
  relatedBy PersonRelation[]  @relation("to")

  @@index([clanId])
}

model Exam {
  id       String   @id
  personId String
  type     ExamType
  year     Int
  kingId   String
  grade    String
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([kingId])
}

model PersonRelation {
  personId        String
  relatedPersonId String
  type            String
  person          Person @relation("from", fields: [personId], references: [id], onDelete: Cascade)
  related         Person @relation("to", fields: [relatedPersonId], references: [id], onDelete: Cascade)

  @@id([personId, relatedPersonId, type])
}

model ClanLocation {
  id         String @id
  clanId     String
  research   ClanResearch @relation(fields: [clanId], references: [clanId], onDelete: Cascade)
  bonGwan    String?
  surname    String?
  kind       String
  name       String
  modernArea String
  latitude   Float
  longitude  Float
  status     String
  confidence String?
  sourceTitle String?
  sourceUrl   String?
  note       String?
  evidence   ClanLocationEvidence[]

  @@index([clanId])
}

model ClanResearch {
  clanId     String @id
  bonGwan    String
  surname    String
  status     String
  note       String?
  reviewedAt DateTime?
  locations  ClanLocation[]
  evidence   ClanLocationEvidence[]

  @@index([bonGwan, surname])
  @@index([status])
}

model ClanLocationEvidence {
  id              String @id
  clanId          String
  research        ClanResearch @relation(fields: [clanId], references: [clanId], onDelete: Cascade)
  locationId      String?
  location        ClanLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  provider        String
  title           String
  url             String
  licenseCode     String
  licenseUrl      String
  retrievedAt     DateTime
  evidenceSummary String
  contentHash     String

  @@index([clanId])
  @@index([locationId])
}
