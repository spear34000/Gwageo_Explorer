# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/dev.db*
/generated/
*.xlsx
*.xls

# local logs
build.log
build.err
dev.log
dev3100.log
dev3100.err

# local research exports (the audited JSON datasets remain tracked)
.tmp-*.json

# deploy artifacts
/deploy/

# Android local/build outputs
/android/local.properties
/artifacts/*.apk

# opencode / codegraph
/.omo/
/.codegraph/
/.playwright-mcp/
/.tooling/
